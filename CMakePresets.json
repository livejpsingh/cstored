{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KVS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Debug (Full debug info, O0)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Release (Optimized, O3, NDEBUG)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dev-asan",
      "displayName": "ASan + UBSan Profile",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KVS_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "dev-tsan",
      "displayName": "ThreadSanitizer Profile",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KVS_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release"
    },
    {
      "name": "dev-asan",
      "configurePreset": "dev-asan"
    },
    {
      "name": "dev-tsan",
      "configurePreset": "dev-tsan"
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-asan",
      "configurePreset": "dev-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev-tsan",
      "configurePreset": "dev-tsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
