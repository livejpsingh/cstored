---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-function-cognitive-complexity

WarningsAsErrors: '*'
HeaderFilterRegex: '.*include/kvs/.*'
FormatStyle: file
CheckOptions:
  readability-redundant-declaration.IgnoreMacros: true
...
